extends layout

block content
  h1 Notes
  div
    p
      form(action="/notes/post" method="POST")
        input#text-input(type="text" name="text" autocomplete="off")
        input(type="submit")
    p
      input#fileSelection(type="file" multiple)
      button#fileUploadButton Upload
  div
    label#status
  each note in notes
    p
      if (typeof note.content === 'string')
        button.copy-button(data-nodeIndex=note.index) 📋
        | &nbsp;
        span(id="note_" + note.index)=note.content
      else if (note.content.type === 'img')
        button.copy-button(data-nodeIndex=note.index) 📋
        | &nbsp;
        img(id="note_" + note.index src="thumbnails/" + note.index + "." + note.content.fileExtension)
